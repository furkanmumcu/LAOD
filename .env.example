# Copy to .env and fill in. .env is gitignored; never commit real values.

# HuggingFace access token.
# Required ONLY for gated models - google/gemma-3-4b-it is gated and is not
# present in the local HF cache, so it must be downloaded.
# Qwen2.5-VL-7B-Instruct and grounding-dino-tiny are ungated AND already cached.
# Create one at https://huggingface.co/settings/tokens (read scope is enough),
# then request access at https://huggingface.co/google/gemma-3-4b-it
HF_TOKEN=

# Optional. All default to paths inside this repository; override only if you
# have moved the assets elsewhere.
# LAOD_DATA_ROOT=./datasets
# LAOD_WEIGHTS_ROOT=./weights
# HF_HOME=
